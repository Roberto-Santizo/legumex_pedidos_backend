{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "isolatedModules": true,
        "lib": ["ES2020", "DOM"],
        "target": "es6",
        "moduleResolution": "NodeNext",
        "module": "NodeNext",
        "strict": false,
        "sourceMap": true,
        "esModuleInterop": true,
        "declaration": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
    },
    "include": [
        "src/**/*.ts"
    ]
}